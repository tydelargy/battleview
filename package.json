{
  "name": "battlemap",
  "version": "0.3.0",
  "description": "Tactical 3D map of your codebase, open PRs and Jira tickets",
  "type": "module",
  "bin": {
    "battlemap": "bin/battlemap.js",
    "battlemap-sync": "bin/battlemap-sync.js"
  },
  "scripts": {
    "start": "node bin/battlemap.js",
    "mock": "node bin/battlemap.js --mock-jira",
    "test": "node --test",
    "e2e": "node e2e/ui.mjs && node e2e/watch.mjs && node e2e/features.mjs && node e2e/notify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tydelargy/battleview.git"
  },
  "homepage": "https://github.com/tydelargy/battleview#readme",
  "keywords": [
    "code-visualization",
    "pull-requests",
    "jira",
    "threejs",
    "treemap"
  ],
  "files": [
    "bin",
    "deploy",
    "server",
    "web",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
